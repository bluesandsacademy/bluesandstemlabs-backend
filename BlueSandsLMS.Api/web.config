<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Let ASP.NET Core handle requests -->
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet" arguments=".\BlueSandsLMS.Api.dll" hostingModel="inprocess" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <environmentVariable name="Frontend__BaseUrl" value="https://app.bluesandstemlabs.com" />
        <environmentVariable name="App__FrontendBaseUrl" value="https://app.bluesandstemlabs.com" />
        <!-- keep your other secrets/connection strings here -->
      </environmentVariables>
    </aspNetCore>

    <!-- REMOVE any IIS-level CORS headers so ASP.NET Core is authoritative -->
    <httpProtocol>
      <customHeaders>
        <remove name="Access-Control-Allow-Origin" />
        <remove name="Access-Control-Allow-Methods" />
        <remove name="Access-Control-Allow-Headers" />
        <remove name="Access-Control-Allow-Credentials" />
        <remove name="Access-Control-Expose-Headers" />
        <remove name="Timing-Allow-Origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Allow OPTIONS verb through request filtering -->
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <!-- Keep HTTPS redirect; do not interfere with preflight -->
    <rewrite>
      <rules>
        <rule name="ForceHttpsExceptApiOptions" enabled="true" stopProcessing="true">
          <match url="(.*)" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{REQUEST_METHOD}" pattern="OPTIONS" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite> 

    <!-- In case host injects a CORS module -->
    <modules>
      <remove name="CorsModule" />
    </modules>
  </system.webServer>
</configuration>
